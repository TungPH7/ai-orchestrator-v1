# Caddy inside the container of the app __APP__ (ai-orchestrator, stack react): it serves the built files on :__PORT__,
# sends /api/* to the app api of the environment, and answers index.html for any other path, so the routes of the app
# load from a link. Caddy of the VPS keeps HTTPS and basic auth in front of it. The name api is the same in every
# environment, so one image serves all three; API_UPSTREAM changes it, as host:port.
{
	admin off
	auto_https off
	persist_config off
	# Trust the X-Forwarded-* headers of the proxy in front, Caddy of the VPS, which reaches this container from a
	# private address (shop SHOP-56, private-car-v1 PCAR-6, private-car-v1-1 PCV11-1). Without it, Caddy here writes its
	# own X-Forwarded-Proto, http, so the api, which reads the X-Forwarded-* headers (server.forward-headers-strategy
	# native), sees http://<admin host> while the browser sends Origin https://<admin host> with every POST, PUT and
	# DELETE: a cross-origin request from an origin it does not list, refused with 403 "Invalid CORS request". With it,
	# the api sees the scheme and host the browser used, and the request is same-origin on every environment. The host
	# passes as it is, since reverse_proxy keeps the Host header.
	servers {
		trusted_proxies static private_ranges
	}
}

:__PORT__ {
	encode gzip
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3001}
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
